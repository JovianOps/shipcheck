{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shipcheck",
  "version": "0.1.0",
  "identifier": "com.shipcheck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "title": "shipcheck", "width": 1180, "height": 780 }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "targets": "all", "icon": [] }
}
